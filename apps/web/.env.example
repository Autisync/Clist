# Supabase-native migration §6 Step 2 (08-supabase-native-migration.md) —
# not wired into any real page yet (see apps/api/README.md's Supabase-native
# section). Both are safe to ship to the browser — anon key + RLS is the
# whole point — but still sourced from a local, gitignored .env.local, never
# hardcoded into a committed file. src/lib/supabase/env.ts reads these.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Google Analytics (layout.tsx) — a real GA4 property's Measurement ID
# (format G-XXXXXXXXXX, from the GA admin UI). Unset skips rendering
# <GoogleAnalytics> entirely, same "swap in when configured" pattern as
# apps/api's GOOGLE_PLACES_API_KEY/VERYFI_* env vars. Vercel Analytics
# (also wired in layout.tsx) needs no credential here — it activates
# automatically on a real Vercel deployment regardless of this file.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Sentry error monitoring (sentry.server.config.ts/sentry.edge.config.ts/
# src/instrumentation-client.ts) — manual setup, not the wizard (see
# sentry.server.config.ts's own comment on why: no TTY in the environment
# this was built in). NEXT_PUBLIC_SENTRY_DSN is not sensitive — a DSN
# identifies where to send events, it isn't a write-protected secret
# (Sentry's own docs say so) — unset means the SDK silently no-ops, same
# "swap in when configured" pattern as everything else in this file. Get
# it from sentry.io -> Settings -> Projects -> fieldready -> Client Keys (DSN).
NEXT_PUBLIC_SENTRY_DSN=

# Optional, build-time only (next.config.ts) — enables source-map upload
# so stack traces in Sentry show real source, not minified bundles. Unset
# skips the upload step with a warning, doesn't fail the build. Get it
# from sentry.io -> Settings -> Auth Tokens (needs project:releases scope).
SENTRY_AUTH_TOKEN=
