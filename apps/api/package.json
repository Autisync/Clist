{
  "name": "@fieldready/api",
  "version": "0.1.0",
  "private": true,
  "description": "Fastify API — architecture §2/§8. Phase 1 scope only: tenancy+RLS, auth (both flows), template engine, sync proof.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "start": "tsx --env-file=.env src/index.ts",
    "start:container": "tsx src/index.ts",
    "build": "tsc -p .",
    "proof": "node --env-file=.env test/phase1-proof.mjs",
    "proof:phase2": "node --env-file=.env test/phase2-proof.mjs",
    "proof:phase3": "node --env-file=.env test/phase3-proof.mjs",
    "proof:phase4": "node --env-file=.env test/phase4-proof.mjs",
    "proof:bridge-auth": "node --env-file=.env test/bridge-auth-proof.mjs",
    "proof:tech-pairing": "node --env-file=.env test/technician-pairing-proof.mjs",
    "proof:field-flow": "node --env-file=.env test/field-flow-proof.mjs",
    "proof:platform-admin": "node --env-file=.env test/platform-admin-proof.mjs",
    "proof:support-tickets": "node --env-file=.env test/support-tickets-proof.mjs",
    "proof:admin-analytics": "node --env-file=.env test/admin-analytics-proof.mjs",
    "proof:places": "node --env-file=.env test/places-provider-proof.mjs"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.5",
    "@fastify/cookie": "^11.1.2",
    "@fastify/multipart": "^9.4.0",
    "@fastify/rate-limit": "^11.2.0",
    "@fieldready/core": "0.1.0",
    "@supabase/supabase-js": "^2.112.3",
    "@types/pg": "^8.23.1",
    "bcryptjs": "^3.0.3",
    "date-holidays": "^3.35.0",
    "fastify": "^5.12.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.0",
    "playwright": "^1.62.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.5.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4"
  }
}
