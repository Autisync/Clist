# Receipt OCR (Phase 4, F20) — real vendor integration, per architecture §6.
# All four required or the provider falls back to FixtureReceiptOcrProvider
# (see receipt-ocr-provider.ts) — deliberate, not a bug: local dev and every
# proof/smoke script run against the deterministic fixture regardless of what
# is in this file, so a missing/partial credential set never breaks anything,
# it just means receipts get parsed by the fixture instead of the real API.
VERYFI_CLIENT_ID=
VERYFI_CLIENT_SECRET=
VERYFI_USERNAME=
VERYFI_API_KEY=

# Supabase-native migration (08-supabase-native-migration.md). Two
# unrelated uses of the SAME project by this point in the migration:
# (1) SUPABASE_SERVICE_ROLE_KEY / SUPABASE_ANON_KEY back the §6 Step 1-4
#     verify-*.mjs scripts and the real RLS-governed `public` schema tables
#     apps/web reads directly.
# (2) SUPABASE_PROJECT_REF + SUPABASE_DB_PASSWORD ALSO now back src/db.ts's
#     real-Postgres connection for the classic Fastify system (apps/api's
#     own routes) — a plain `postgres`-role connection into its own
#     dedicated schema (FASTIFY_DB_SCHEMA below), never touching `public`.
#     SUPABASE_SERVICE_ROLE_KEY bypasses RLS entirely and
#     SUPABASE_DB_PASSWORD is a superuser Postgres credential: both
#     server-only, forever, never in apps/web, never committed with real
#     values.
SUPABASE_PROJECT_REF=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_PASSWORD=
# Anon key — safe to ship to the browser (that's what "anon" means, RLS is
# the actual boundary), but still needed here too for verify-office-auth.mjs
# (§6 Step 2), which signs in as a real browser would: anon key + password,
# no service_role. Same value as apps/web/.env.local's
# NEXT_PUBLIC_SUPABASE_ANON_KEY.
SUPABASE_ANON_KEY=

# Optional — schema src/db.ts creates/uses for the classic Fastify system's
# tables within the same Supabase project as (2) above. Defaults to
# "fastify_api" if unset; only override this to run a second, fully
# separate copy of the Fastify system's data against the same project.
FASTIFY_DB_SCHEMA=

# Optional but STRONGLY recommended for real hosting (unset is fine for
# local dev with real IPv6 route-ability). The direct connection above
# (db.<project-ref>.supabase.co) is IPv6-only — Supabase's own docs say so
# — and confirmed here to fail outright (ENOTFOUND / "Network is
# unreachable") from any environment without real IPv6 egress, which many
# hosting platforms either lack entirely (Render, confirmed) or support
# unreliably in some regions (Fly.io has had real reported IPv6 outages
# against Supabase specifically). Setting this switches src/db.ts to
# Supabase's own Supavisor connection pooler instead, which is
# IPv4-reachable — Supabase's own documented fix for exactly this
# situation. Get the value from the Supabase dashboard: Project Settings →
# Database → Connect → look for the "aws-<0 or 1>-<region>.pooler.supabase.com"
# host (the generation prefix and region are assigned per-project and
# aren't guessable/constructible from SUPABASE_PROJECT_REF alone — the
# dashboard is the only reliable source). Session mode (port 5432, which
# db.ts hardcodes when this is set) is required, not transaction mode
# (6543) — confirmed empirically that SET LOCAL role/app.current_tenant_id
# behave identically to a direct connection in session mode.
SUPABASE_DB_POOLER_HOST=
