{
  "name": "fieldready",
  "private": true,
  "version": "0.1.0",
  "description": "FieldReady monorepo — see CLAUDE.md for the project brief and build order.",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev:api": "npm run dev --workspace=apps/api",
    "dev:web": "npm run dev --workspace=apps/web",
    "build": "npm run build --workspace=packages/core --workspace=apps/api --workspace=apps/web",
    "proof:phase1": "npm run proof --workspace=apps/api",
    "proof:phase2": "npm run proof:phase2 --workspace=apps/api",
    "proof:phase3": "npm run proof:phase3 --workspace=apps/api",
    "proof:phase4": "npm run proof:phase4 --workspace=apps/api",
    "proof:bridge-auth": "npm run proof:bridge-auth --workspace=apps/api",
    "proof:tech-pairing": "npm run proof:tech-pairing --workspace=apps/api",
    "proof:field-flow": "npm run proof:field-flow --workspace=apps/api",
    "smoke:web": "node --env-file=apps/api/.env apps/web/test/smoke.mjs",
    "verify:schema": "node verify-schema.mjs 03-schema.sql",
    "verify:seed": "node verify-seed.mjs 03-schema.sql seed.sql",
    "verify:schema-supabase": "node --env-file=apps/api/.env apps/api/supabase/verify-schema-supabase.mjs",
    "verify:office-auth-supabase": "node --env-file=apps/api/.env apps/api/supabase/verify-office-auth.mjs",
    "verify:step3-supabase": "node --env-file=apps/api/.env apps/api/supabase/verify-step3-read-write.mjs",
    "verify:holidays-supabase": "node --env-file=apps/api/.env apps/api/supabase/verify-holidays.mjs",
    "verify:step4-supabase": "node --env-file=apps/api/.env apps/api/supabase/verify-step4-rpc.mjs",
    "verify:create-job-supabase": "node --env-file=apps/api/.env apps/api/supabase/verify-create-job.mjs",
    "verify:job-complete-supabase": "node --env-file=apps/api/.env apps/api/supabase/verify-job-complete.mjs",
    "verify:sqt-supabase": "node --env-file=apps/api/.env apps/api/supabase/verify-suppliers-quotes-technicians.mjs",
    "verify:ited-classification-supabase": "node --env-file=apps/api/.env apps/api/supabase/verify-ited-classification.mjs",
    "apply:rpc-supabase": "node --env-file=apps/api/.env apps/api/supabase/apply-rpc.mjs",
    "seed:supabase": "node --env-file=apps/api/.env apps/api/supabase/apply-seed.mjs",
    "provision:tenant-supabase": "node --env-file=apps/api/.env apps/api/supabase/provision-tenant.mjs",
    "seed:demo-job-supabase": "node --env-file=apps/api/.env apps/api/supabase/seed-demo-job.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true,
    "sharp@0.34.5": true,
    "fsevents@2.3.2": true
  }
}
